{
  "expo": {
    "name": "Iron Week",
    "slug": "iron-week",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ironweek.app",
      "infoPlist": {
        "NSMotionUsageDescription": "Iron Week counts your steps during a walk."
      }
    },
    "android": {
      "package": "com.ironweek.app",
      "adaptiveIcon": {
        "backgroundColor": "#121518",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#121518"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#f2b621"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Iron Week uses your photos only when you choose a pass image to save on this phone.",
          "cameraPermission": "Iron Week uses the camera only to scan food barcodes. Pass photos come from your gallery.",
          "microphonePermission": false
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Iron Week uses the camera only to scan food barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health-connect"
    ],
    "extra": {
      "eas": {
        "projectId": "e23483e7-8545-481a-8b47-aff2e1b33331"
      }
    },
    "owner": "debjeetchakroborty",
    "scheme": "ironweek",
    "experiments": {
      "typedRoutes": true
    }
  }
}
