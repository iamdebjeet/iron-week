{
  "expo": {
    "name": "Iron Week",
    "slug": "iron-week",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ironweek.app"
    },
    "android": {
      "package": "com.ironweek.app",
      "adaptiveIcon": {
        "backgroundColor": "#121518",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#121518"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#f2b621"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Iron Week uses your photos only when you choose a pass image to save on this phone.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e23483e7-8545-481a-8b47-aff2e1b33331"
      }
    },
    "owner": "debjeetchakroborty"
  }
}
